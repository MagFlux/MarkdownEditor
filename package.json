{
  "name": "markdowneditor",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "author": "MagFlux",
  "description": "Multi-tab Markdown editor with live preview (Electron shell)",
  "desktopName": "markdown-editor.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/test.mjs",
    "verify": "node test/verify.mjs",
    "verify-undo": "node test/verifyUndo.mjs",
    "verify-save": "node test/verifySaveOpen.mjs",
    "verify-toolbar": "node test/verifyToolbar.mjs",
    "verify-paste": "node test/verifyPaste.mjs",
    "verify-export": "node test/verifyExport.mjs",
    "verify-math": "node test/verifyMath.mjs",
    "verify-scroll": "node test/verifyScroll.mjs",
    "verify-scrollsync": "node test/verifyScrollSync.mjs",
    "verify-modescroll": "node test/verifyModeScroll.mjs",
    "verify-modefocus": "node test/verifyModeFocus.mjs",
    "verify-tabclick": "node test/verifyTabClick.mjs",
    "verify-tabscroll": "node test/verifyTabScroll.mjs",
    "verify-themescroll": "node test/verifyThemeScroll.mjs",
    "verify-mermaidflicker": "node test/verifyMermaidFlicker.mjs",
    "verify-mermaidstyle": "node test/verifyMermaidStyle.mjs",
    "verify-mermaidfade": "node test/verifyMermaidFade.mjs",
    "verify-tauri": "node test/verifyTauriClose.mjs",
    "verify-caret": "node test/verifyCaret.mjs",
    "verify-find": "node test/verifyFind.mjs",
    "verify-tasks": "node test/verifyTasks.mjs",
    "verify-recent": "node test/verifyRecent.mjs",
    "verify-dialogscroll": "node test/verifyDialogScroll.mjs",
    "verify-codecolor": "node test/verifyCodeColor.mjs",
    "electron": "electron .",
    "electron:dev": "node scripts/before-build.cjs && node scripts/electron-dev.cjs",
    "electron:start": "node scripts/before-build.cjs && npm run build && electron .",
    "electron:build": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "mermaid": "^12.0.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  }
}
