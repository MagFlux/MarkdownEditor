{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "main-capability",
  "description": "Capability for the main editor window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "core:path:default",
    "core:window:allow-destroy",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    { "identifier": "fs:scope", "allow": ["**"] }
  ]
}
